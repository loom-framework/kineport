{
  "name": "My W3C App",
  "short_name": "W3CApp",
  "id": "/index.html",
  "start_url": "/",
 "display_override": ["standalone", "minimal-ui"],
 "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#0059ff",
  "icons": [
    { "src": "assets/icons/icon.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/icons/icon.png", "sizes": "512x512", "type": "image/png" }
  ],
  
  "protocol_handlers": [
    {
      "protocol": "web+tea",
      "url": "/tea?type=%s"
    },
    {
      "protocol": "web+coffee",
      "url": "/coffee?type=%s"
    }
  ]
}